{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo tree *)",
      "Bash(just --list)",
      "Bash(just build)",
      "Bash(just test)",
      "Bash(just check)",
      "Bash(just fmt)",
      "Bash(just lint)",
      "Bash(dev-tools/sq-sandbox *)",
      "Bash(./dev-tools/sq-sandbox *)",
      "Bash(python3 -m unittest discover -s .claude/hooks *)",
      "Bash(bd ready *)",
      "Bash(bd show *)",
      "Bash(bd list *)",
      "Bash(bd search *)",
      "Bash(bd stats *)",
      "Bash(bd blocked *)",
      "Bash(bd prime *)",
      "Bash(bd memories *)",
      "Bash(bd create *)",
      "Bash(bd update *)",
      "Bash(bd close *)",
      "Bash(bd dep *)"
    ],
    "ask": [
      "Bash(./publish.sh *)",
      "Bash(publish.sh *)",
      "Bash(just ship *)",
      "Bash(cargo publish *)",
      "Bash(cargo yank *)",
      "Bash(cargo install *)",
      "Bash(gh release *)",
      "Bash(docker push *)",
      "Bash(bash ./publish.sh *)",
      "Bash(bash publish.sh *)",
      "Bash(sh ./publish.sh *)",
      "Bash(sh publish.sh *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(./install.sh *)",
      "Bash(bash install.sh *)",
      "Bash(bash ./install.sh *)",
      "Bash(sh install.sh *)",
      "Bash(sh ./install.sh *)",
      "Bash(*.cargo/bin/sq*)",
      "Edit(~/.shellquest/**)",
      "Write(~/.shellquest/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-live-save.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
