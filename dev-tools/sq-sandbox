#!/usr/bin/env python3
"""Run the dev build of `sq` against a throwaway HOME.

The developer plays this game: ~/.shellquest/save.json is a live character and
their shell hook ticks it before every prompt. Every manual `sq` run made while
developing goes through this wrapper so it lands in an isolated sandbox instead.

  dev-tools/sq-sandbox new [--name N] [--class C] [--race R] [--permadeath]
  dev-tools/sq-sandbox status                  # any other args pass through to sq
  dev-tools/sq-sandbox tick "git commit" [-n 20] [--exit-code 1] [--cwd /tmp/x]
  dev-tools/sq-sandbox set character.level=60 character.gold=50000 quest_refreshed=@now-1d
  dev-tools/sq-sandbox show [character.inventory]
  dev-tools/sq-sandbox boss ["kernel panic"] [--age 25h]   # spawn a world boss now
  dev-tools/sq-sandbox tty --input 1 --input c -- arena
  dev-tools/sq-sandbox run reset               # `run` forces passthrough (sq reset)
  dev-tools/sq-sandbox path | reset            # print (creating it) / wipe the sandbox

Wrapper options go before the command:
  --release     use target/release/sq (default: target/debug/sq)
  --no-build    skip `cargo build` (default: build first, a no-op when fresh)
  --home DIR    sandbox HOME (default: $SQ_SANDBOX_HOME or <repo>/.sq-sandbox/home)
  --in DIR      working directory for sq (default: the sandbox HOME, so the
                home-only commands shop/buy/sell/enchant/quest work)
  --paced       keep the arena's 1.5 s pacing (default: SQ_NO_PACING=1)

Keep the sandbox path free of zone keywords (tmp, var, private, target, src,
dev, ...): zones.rs matches path segments before it checks for $HOME, so a
HOME under e.g. /var/folders would not register as Home Village.

Stdlib only; Python 3.10+.
"""

from __future__ import annotations

import argparse
import codecs
import datetime
import fcntl
import json
import os
import pty
import pwd
import re
import select
import shutil
import signal
import struct
import subprocess
import sys
import tempfile
import termios
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
RUN_TIMEOUT = 120  # seconds, for runs whose output is captured
STREAM_LIMIT_BYTES = 4_000_000  # sq's interactive prompts loop forever on closed stdin
STREAM_LIMIT_SECONDS = 300
DEFAULT_HOME = REPO / ".sq-sandbox" / "home"
MARKER = ".sq-sandbox-home"

# Menu order of `sq init` (src/main.rs cmd_init). `new` verifies the result, so
# a reordered menu fails loudly instead of creating the wrong character.
CLASSES = ["wizard", "warrior", "rogue", "ranger", "necromancer"]
RACES = ["human", "elf", "dwarf", "orc", "goblin"]

ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b[()][0-9A-Za-z]")


def die(msg: str, code: int = 1) -> None:
    print(f"sq-sandbox: {msg}", file=sys.stderr)
    sys.exit(code)


def note(msg: str) -> None:
    print(f"[sq-sandbox] {msg}", file=sys.stderr)


def real_home() -> Path:
    # Resolve from the password database, not $HOME, so an already-overridden
    # HOME can't trick the safety checks.
    return Path(pwd.getpwuid(os.getuid()).pw_dir).resolve()


class Sandbox:
    def __init__(self, home: Path, release: bool, build: bool, workdir: Path | None, paced: bool):
        self.home = home.expanduser().resolve()
        self.release = release
        self.build = build
        self.workdir = workdir.expanduser().resolve() if workdir else self.home
        self.paced = paced
        self._check_home()

    def _check_home(self) -> None:
        real = real_home()
        if self.home == Path("/") or self.home == real or real.is_relative_to(self.home):
            die(f"refusing to use {self.home} as the sandbox: it would contain your real home")
        if self.home.is_relative_to(real / ".shellquest"):
            die(f"refusing to use {self.home}: it is inside your live save directory")
        if REPO.is_relative_to(self.home):
            die(f"refusing to use {self.home} as the sandbox: it contains this repository")

    def _check_tree(self) -> None:
        """The save must live inside the sandbox: no symlinks toward a real save."""
        for path in (self.home / ".shellquest", self.save_path):
            if path.is_symlink():
                die(f"{path} is a symlink; refusing (it could point at a real save)")
            if path.exists() and not path.resolve().is_relative_to(self.home):
                die(f"{path} resolves outside the sandbox; refusing")

    @property
    def save_path(self) -> Path:
        return self.home / ".shellquest" / "save.json"

    @property
    def binary(self) -> Path:
        return REPO / "target" / ("release" if self.release else "debug") / "sq"

    def ensure_built(self) -> None:
        if self.build:
            self._cargo_build()
            if self._stale():
                # The cargo cache quirk from AGENTS.md: the build reports fresh while the
                # binary is older than the sources. QA against stale code is worse than slow.
                note("binary is older than the sources although cargo reported it fresh; rebuilding from clean")
                subprocess.run(["cargo", "clean", "--quiet", "-p", "shellquest"], cwd=REPO)
                self._cargo_build()
                if self._stale():
                    die(f"{self.binary} is still older than src/ after a clean rebuild")
        if not self.binary.exists():
            die(f"{self.binary} not found (drop --no-build or run cargo build)")

    def _cargo_build(self) -> None:
        cmd = ["cargo", "build", "--quiet", "--bin", "sq"] + (["--release"] if self.release else [])
        # Real environment on purpose: cargo/rustup live under the real HOME.
        if subprocess.run(cmd, cwd=REPO).returncode != 0:
            die("cargo build failed")

    def _stale(self) -> bool:
        if not self.binary.exists():
            return False  # reported by the caller
        sources = [*(REPO / "src").rglob("*.rs"), REPO / "Cargo.toml", REPO / "Cargo.lock"]
        newest = max(src.stat().st_mtime for src in sources if src.exists())
        return self.binary.stat().st_mtime < newest

    def prepare(self) -> None:
        # Stamp only directories this tool creates (or that are empty), so a stray
        # --home can never turn an existing directory into something `reset` deletes.
        marker = self.home / MARKER
        if not self.home.exists():
            self.home.mkdir(parents=True)
            marker.touch()
        elif not marker.exists():
            if any(self.home.iterdir()):
                die(f"{self.home} is not empty and was not created by sq-sandbox; pick a new or empty directory")
            marker.touch()
        self._check_tree()

    def env(self) -> dict[str, str]:
        env = dict(os.environ)
        env["HOME"] = str(self.home)
        if not self.paced:
            env["SQ_NO_PACING"] = "1"
        return env

    def run(self, args: list[str], stdin: str | None = None) -> subprocess.CompletedProcess:
        """Run sq and capture its output (stdout+stderr merged), capped in time and size."""
        self.prepare()
        proc = subprocess.Popen(
            [str(self.binary), *args],
            cwd=self.workdir,
            env=self.env(),
            stdin=subprocess.PIPE if stdin is not None else subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
        if stdin is not None:  # answers are tiny, so writing them up front can't fill the pipe
            proc.stdin.write(stdin.encode())
            proc.stdin.close()
        out, start, fd, problem = bytearray(), time.monotonic(), proc.stdout.fileno(), None
        while problem is None:
            ready, _, _ = select.select([fd], [], [], 0.5)
            if ready:
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                out += chunk
            if len(out) > STREAM_LIMIT_BYTES:
                problem = f"produced more than {STREAM_LIMIT_BYTES // 1_000_000} MB of output"
            elif time.monotonic() - start > RUN_TIMEOUT:
                problem = f"did not finish within {RUN_TIMEOUT}s"
        if problem:
            proc.kill()
            proc.wait()
            die(f"`sq {' '.join(args)}` {problem} (an interactive prompt looping on its input?)")
        return subprocess.CompletedProcess(args, proc.wait(), out.decode("utf-8", errors="replace"), None)

    def stream(self, args: list[str]) -> int:
        """Pass sq's stdout/stderr through, killing it if it floods output or hangs."""
        self.prepare()
        proc = subprocess.Popen(
            [str(self.binary), *args], cwd=self.workdir, env=self.env(), stdout=subprocess.PIPE, stderr=subprocess.PIPE
        )
        sinks = {proc.stdout.fileno(): sys.stdout.buffer, proc.stderr.fileno(): sys.stderr.buffer}
        live, total, start, reason = set(sinks), 0, time.monotonic(), None
        while live and reason is None:
            ready, _, _ = select.select(list(live), [], [], 0.5)
            for fd in ready:
                chunk = os.read(fd, 65536)
                if not chunk:
                    live.discard(fd)
                    continue
                sinks[fd].write(chunk)
                sinks[fd].flush()
                total += len(chunk)
            if total > STREAM_LIMIT_BYTES:
                reason = f"more than {STREAM_LIMIT_BYTES // 1_000_000} MB of output"
            elif time.monotonic() - start > STREAM_LIMIT_SECONDS:
                reason = f"still running after {STREAM_LIMIT_SECONDS}s"
        if reason:
            proc.kill()
            proc.wait()
            note(
                f"killed sq: {reason}. It is probably an interactive prompt looping on closed stdin; "
                "pipe the answers in, e.g. printf '1\\ny\\n' | dev-tools/sq-sandbox prestige"
            )
            return 124
        return proc.wait()

    def load(self) -> dict:
        self._check_tree()
        if not self.save_path.exists():
            die("no sandbox character yet; create one with: dev-tools/sq-sandbox new")
        return json.loads(self.save_path.read_text())

    def load_raw(self) -> str:
        self.load()  # existence and symlink checks
        return self.save_path.read_text()

    def save_checked(self, data: dict, previous: str) -> None:
        """Save, then make sure sq itself can still load it; restore the previous save if not."""
        self.save(data)
        probe = self.run(["status"])
        if "Failed to parse save" in probe.stdout:
            fd, tmp = tempfile.mkstemp(dir=self.save_path.parent, prefix=".save.", suffix=".sandbox-tmp")
            with os.fdopen(fd, "w") as f:
                f.write(previous)
            os.replace(tmp, self.save_path)
            detail = next((line for line in probe.stdout.splitlines() if "Failed to parse save" in line), "")
            die(f"sq cannot load the edited save, so it was restored. {detail.strip()}")

    def load_or_none(self) -> dict | None:
        try:
            return json.loads(self.save_path.read_text())
        except (OSError, ValueError):
            return None

    def save(self, data: dict) -> None:
        self._check_tree()
        # mkstemp creates the file exclusively (never follows a planted symlink).
        fd, tmp = tempfile.mkstemp(dir=self.save_path.parent, prefix=".save.", suffix=".sandbox-tmp")
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(data, indent=2))
        os.replace(tmp, self.save_path)

    def wipe(self) -> None:
        if not self.home.exists():
            return
        if not (self.home / MARKER).exists() and any(self.home.iterdir()):
            die(f"{self.home} has no {MARKER} marker; not deleting a directory this tool did not create")
        shutil.rmtree(self.home)

    def check_sq_args(self, argv: list[str]) -> None:
        """Refuse sq invocations that reach outside the sandbox, whatever the entry point."""
        first = next((a for a in argv if not a.startswith("-")), "")
        if first == "update":
            die("`sq update` reinstalls the real binary via cargo; not available in the sandbox")
        if first == "hook":
            target = None
            for j, a in enumerate(argv):
                if a.startswith("--file="):
                    target = a.split("=", 1)[1]
                elif a == "--file" and j + 1 < len(argv):
                    target = argv[j + 1]
            if target is not None:
                resolved = (self.workdir / Path(target).expanduser()).resolve()
                if not resolved.is_relative_to(self.home):
                    die(f"`hook --file {target}` would write outside the sandbox ({resolved})")


# ── state summaries ──────────────────────────────────────────────────────────


def snapshot(data: dict | None) -> dict:
    if not data:
        return {}
    c = data.get("character", {})
    boss = data.get("active_boss")
    return {
        "level": c.get("level"),
        "xp": c.get("xp"),
        "hp": f"{c.get('hp')}/{c.get('max_hp')}",
        "gold": c.get("gold"),
        "kills": c.get("kills"),
        "deaths": c.get("deaths"),
        "inventory": len(c.get("inventory") or []),
        "boss": f"{boss['name']} {boss['hp']}/{boss['max_hp']}" if boss else "-",
    }


def describe_delta(before: dict | None, after: dict | None) -> str:
    if after is None:
        return "save file is gone (permadeath death or reset?)"
    b, a = snapshot(before), snapshot(after)
    parts = []
    for key, now in a.items():
        was = b.get(key)
        parts.append(f"{key} {now}" if was in (None, now) else f"{key} {was}→{now}")
    return ", ".join(parts)


